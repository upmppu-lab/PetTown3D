        uiSubText = NewText("StatusSub", main.transform, "", 14, uiMuted, TextAnchor.UpperLeft, FontStyle.Normal);
        Anchor(uiSubText.rectTransform, new Vector2(0, 1), new Vector2(0, 1), new Vector2(0, 1), new Vector2(18, -40), new Vector2(250, 22));
