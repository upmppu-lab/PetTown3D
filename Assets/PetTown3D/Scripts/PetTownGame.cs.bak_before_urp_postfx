                float top=170, bottom=h-92, panelH=Mathf.Min(405,bottom-top);
                Rect panel=new Rect(10,top,w-80,panelH);
                Card(panel,new Color(.99f,.94f,.83f,.97f));
                float inner=panel.width-26;
                int count=mode==Mode.Build?types.Length:mode==Mode.Furniture?furniture.Length:mode==Mode.Customize?6:7;
                if(mobileManagementOpen)count=7;
                mobileScroll=GUI.BeginScrollView(new Rect(panel.x+9,panel.y+9,panel.width-18,panel.height-18),mobileScroll,new Rect(0,0,inner,44+count*51));
                bool manage=mobileManagementOpen;
                InkLabel(new Rect(8,0,inner,32),manage?"PET SHOP":mode==Mode.Build?"BUILDINGS":mode==Mode.Furniture?"DECORATE":"CHARACTER",mobileText,cocoa);
                if(!manage && mode==Mode.Build)
                {
                    for(int i=0;i<types.Length;i++)if(FancyButton(new Rect(8,36+i*51,inner-6,44),types[i]+"  ·  "+costs[i],i==selected?mint:cream))selected=i;
                }
                else if(!manage && mode==Mode.Furniture)
                {
                    for(int i=0;i<furniture.Length;i++)if(FancyButton(new Rect(8,36+i*51,inner-6,44),furniture[i]+"  ·  50",i==furnitureChoice?mint:cream,GetItemIcon(FurnitureResource[i])))furnitureChoice=i;
                }
                else if(!manage && mode==Mode.Customize)
                {
                    if(FancyButton(new Rect(8,36,inner-6,44),"Hair  "+hairStyle,pink))hairStyle=(hairStyle+1)%4;
                    if(FancyButton(new Rect(8,87,inner-6,44),"Face  "+faceStyle,cream))faceStyle=(faceStyle+1)%4;
                    if(FancyButton(new Rect(8,138,inner-6,44),"Body  "+bodyStyle,blue))bodyStyle=(bodyStyle+1)%4;
                    if(FancyButton(new Rect(8,189,inner-6,44),"Legs  "+legStyle,lilac))legStyle=(legStyle+1)%4;
                    if(FancyButton(new Rect(8,240,inner-6,44),"Accessory  "+accessory,pink))accessory=(accessory+1)%3;
                    if(FancyButton(new Rect(8,291,inner-6,44),"Apply",mint)){RebuildHero();SaveGame();SetMode(Mode.Play);}
                }
                else
                {
                    if(FancyButton(new Rect(8,36,inner-6,44),"2 Puppies  ·  120",pink))BuyPets(0,120);
                    if(FancyButton(new Rect(8,87,inner-6,44),"2 Kittens  ·  120",cream))BuyPets(1,120);
                    if(shopLevel>=2 && FancyButton(new Rect(8,138,inner-6,44),"2 Bunnies  ·  180",lilac))BuyPets(2,180);
                    if(reputation>=shopLevel*10 && FancyButton(new Rect(8,189,inner-6,44),"Upgrade  ·  "+shopLevel*400,mint))
                    {if(money>=shopLevel*400){money-=shopLevel*400;shopLevel++;Message("Shop upgraded!");SaveGame();}}
                    if(FancyButton(new Rect(8,240,inner-6,44),"Toggle roof",blue))ToggleMobileRoof();
                    if(FancyButton(new Rect(8,291,inner-6,44),"Save",mint))SaveGame();
                    if(FancyButton(new Rect(8,342,inner-6,44),"Close",amber))mobileManagementOpen=false;
                }
                GUI.EndScrollView();
            }
        }
        if(Time.time<noticeTime)
        {
            Card(new Rect(45,h-118,w-90,31),cocoa);
            InkLabel(new Rect(53,h-116,w-106,26),notice,mobileSmall,cream);
        }
        GUI.matrix=previous;
    }
    void ToggleMobileRoof()
    {
        showRoofs=!showRoofs;
        foreach(var b in buildings)if(b!=null)foreach(var r in b.GetComponentsInChildren<Transform>(true))if(r.name=="Toggle_Roof")r.gameObject.SetActive(showRoofs);
    }


    void BuyPets(int pet,int price)
    {
        if(money<price){Message("Not enough coins to order pets");return;}
        money-=price;
        if(pet==0)dogStock+=2;else if(pet==1)catStock+=2;else rabbitStock+=2;
        inventory=dogStock+catStock+rabbitStock;
        Message("Two "+petNames[pet]+" pets arrived!");SaveGame();
    }
    void StartOrder()
    {
        if(shop==null)return;
        orderTimer=0;orderPet=UnityEngine.Random.Range(0,shopLevel>=2?3:2);
        orderDeadline=Time.time+42f;
        Vector3 p=shopPosition+new Vector3(0,0,-7);
        waitingCustomer=new GameObject("WAITING_CUSTOMER_REPLACEABLE");
        waitingCustomer.transform.position=new Vector3(p.x,Ground(p.x,p.z),p.z);
        Part(PrimitiveType.Capsule,"Body",waitingCustomer.transform.position+Vector3.up*1.2f,new Vector3(.75f,1.3f,.7f),Mat(new Color(.84f,.5f,.78f)),waitingCustomer.transform);
        Part(PrimitiveType.Sphere,"Head",waitingCustomer.transform.position+Vector3.up*2.5f,Vector3.one,skin,waitingCustomer.transform);
        Message("Customer arrived! Wants a "+petNames[orderPet]+". Press E or SERVE.");
    }
    void ServeOrder()
    {
        if(orderPet<0)return;
        int count=orderPet==0?dogStock:orderPet==1?catStock:rabbitStock;
        if(count<=0){Message("Out of "+petNames[orderPet]+" stock. Order more!");return;}
        if(orderPet==0)dogStock--;else if(orderPet==1)catStock--;else rabbitStock--;
        inventory=dogStock+catStock+rabbitStock;
        int income=(orderPet==2?330:240)+Mathf.Min(150,shopLevel*20)+Mathf.Min(100,population*2);
        money+=income;sold++;completedOrders++;reputation+=2;
        Message("Adoption successful! +"+income+" coins, +2 fame");
        EndOrder();SaveGame();
    }
    void FailOrder()
    {
        missedOrders++;reputation=Mathf.Max(0,reputation-1);
        Message("Customer left without a pet. -1 fame");EndOrder();SaveGame();
    }
    void EndOrder()
    {
        orderPet=-1;orderTimer=0;
        if(waitingCustomer!=null)Destroy(waitingCustomer);
        waitingCustomer=null;
    }
    // Real pet models live in Resources/pets/<name>.glb. Add more paths here as more are
    // made (dog_2, cat_1, ...) — assigned round-robin across the 4 shop display slots, and
    // any slot beyond what's been added yet falls back to the simple placeholder shape.
    static readonly string[] PetResources = { "pets/dog_1" };
    // One live pet (not four) that actually wanders a small patch of the Pet Shop floor and
    // plays its real walk/idle animation, instead of four static display statues.
    GameObject petInstance; VillagerAnim petAnim; Vector3 petHome, petWanderTarget; float petNextPick;
    float petBobPhase; // drives the procedural trot-bounce fallback (see UpdatePet) while moving
    void CreatePetDisplays()
    {
        if(shop==null)return;
        // Wander patch centered near the real Pet Bed furniture (placed separately in
        // CreateBuilding's kind==0 block) instead of drawing its own duplicate bed shape here —
        // that duplicate was the second, plain-cube "bed" overlapping the real furniture prop.
        // Ground(x,z) returns the actual shop floor height (buildingFloors.floorY), so the dog
        // starts glued to the real floor instead of a hand-guessed Y offset.
        Vector3 p=shopPosition+new Vector3(-3.6f,0,-1f);
        GameObject pet=new GameObject("PET_PLACEHOLDER_REPLACEABLE");pet.transform.position=p;
        float floorY=Ground(p.x,p.z); float targetHeightPet=.75f;
        petHome=new Vector3(p.x,floorY,p.z); petWanderTarget=petHome; petNextPick=Time.time+UnityEngine.Random.Range(2f,4f);
        GameObject prefab = PetResources.Length>0 ? Resources.Load<GameObject>(PetResources[0]) : null;
        if(prefab!=null)
        {
            GameObject instance=Instantiate(prefab,pet.transform);
            instance.name="PET_MODEL_REPLACEABLE";
            instance.transform.position=p;
            instance.transform.rotation=Quaternion.Euler(0,UnityEngine.Random.Range(0f,360f),0);
            instance.transform.localScale=Vector3.one;
            MarkNavMeshIgnore(pet);
            foreach (var c in instance.GetComponentsInChildren<Collider>()) Destroy(c);
            petInstance=instance;
            // Every same-frame measurement attempt (sharedMesh bounds, local bounds,
            // Renderer.bounds) gave inconsistent numbers for this model — Unity hasn't run
            // its first skinning/bounds update pass yet on the same frame as Instantiate(),
            // so nothing read right then is trustworthy. The reliable fix for this exact
            // class of bug is to wait one frame (by which point Unity has actually updated
            // the renderer) and THEN measure Renderer.bounds in world space.
            StartCoroutine(FitModelNextFrame(instance,floorY,targetHeightPet));
            VillagerAnim animInfo;
            if (SetupPetAnimation(instance, out animInfo)) petAnim = animInfo;
            return;
        }
        Part(PrimitiveType.Sphere,"Body",p+Vector3.up*.65f,new Vector3(.9f,.65f,1.2f),roofMat,pet.transform);
        Part(PrimitiveType.Sphere,"Head",p+new Vector3(0,1,-.5f),new Vector3(.8f,.7f,.7f),roofMat,pet.transform);
    }
    // Same idle/walk clip resolution SpawnVillagerModel uses (legacy Animation, Animator with a
    // wired controller, or raw sub-asset clips glTFast left unwired) kept separate so villager
    // behavior is never risked by pet-specific changes.
    bool SetupPetAnimation(GameObject instance, out VillagerAnim animInfo)
    {
        animInfo = null;
        var legacy = instance.GetComponentInChildren<Animation>(true);
        var animator = instance.GetComponentInChildren<Animator>(true);
        string idleName=null, walkName=null, runName=null, firstName=null;
        if (legacy != null)
        {
            foreach (AnimationState st in legacy)
            {
                st.wrapMode = WrapMode.Loop;
                if (st.clip != null) StripBakedRootMotion(st.clip);
                ClassifyClip(st.name, ref idleName, ref walkName, ref runName, ref firstName);
            }
            if (walkName == null) walkName = runName;
            if (idleName == null) idleName = walkName ?? firstName;
            if (idleName != null)
            {
                legacy.wrapMode = WrapMode.Loop; legacy.Play(idleName);
                animInfo = new VillagerAnim { anim = legacy, idleClip = idleName, walkClip = walkName ?? idleName, runClip = runName ?? walkName ?? idleName, model = instance.transform };
                if (animator != null) animator.enabled = false;
                return true;
            }
        }
        if (animator != null && animator.runtimeAnimatorController != null)
        {
            var clips = animator.runtimeAnimatorController.animationClips;
            idleName = walkName = runName = firstName = null;
            if (clips != null) foreach (var clip in clips) if (clip != null) { StripBakedRootMotion(clip); ClassifyClip(clip.name, ref idleName, ref walkName, ref runName, ref firstName); }
            if (walkName == null) walkName = runName;
            if (idleName == null) idleName = walkName ?? firstName;
            if (idleName != null)
            {
                animator.applyRootMotion=false; animator.enabled=true; animator.speed=1f; animator.Play(idleName,0,0f);
                animInfo = new VillagerAnim { animator = animator, idleClip = idleName, walkClip = walkName ?? idleName, runClip = runName ?? walkName ?? idleName, model = instance.transform };
                return true;
            }
        }
        AnimationClip[] allClips = PetResources.Length>0 ? Resources.LoadAll<AnimationClip>(PetResources[0]) : null;
        if (allClips != null && allClips.Length > 0)
        {
            var legacyPlayer = instance.GetComponent<Animation>();
            if (legacyPlayer == null) legacyPlayer = instance.AddComponent<Animation>();
            idleName = walkName = runName = firstName = null;
            foreach (var clip in allClips)
            {
                if (clip == null) continue;
                StripBakedRootMotion(clip); clip.legacy = true;
                legacyPlayer.AddClip(clip, clip.name);
                var state = legacyPlayer[clip.name];
                if (state != null) state.wrapMode = WrapMode.Loop;
                ClassifyClip(clip.name, ref idleName, ref walkName, ref runName, ref firstName);
            }
            if (walkName == null) walkName = runName;
            if (idleName == null) idleName = walkName ?? firstName;
            if (idleName != null)
            {
                legacyPlayer.wrapMode = WrapMode.Loop; legacyPlayer.Play(idleName);
                animInfo = new VillagerAnim { anim = legacyPlayer, idleClip = idleName, walkClip = walkName ?? idleName, runClip = runName ?? walkName ?? idleName, model = instance.transform };
                return true;
            }
        }
        return false;
    }
    // Moves the pet around a small patch of floor near its bed and drives its walk/idle
    // animation. Kept out of the villager wander system entirely (no NavMeshAgent, no shared
    // dictionaries) so it can never wander out of the shop and never risks villager behavior.
    void UpdatePet(float dt)
    {
        if (petInstance == null) return;
        Vector3 cur = petInstance.transform.position;
        if (Time.time > petNextPick || Vector3.Distance(cur, petWanderTarget) < 0.3f)
        {
            Vector2 off = UnityEngine.Random.insideUnitCircle * 1.8f;
            petWanderTarget = petHome + new Vector3(off.x, 0, off.y);
            petNextPick = Time.time + UnityEngine.Random.Range(3f, 6f);
        }
        bool moving = Vector3.Distance(cur, petWanderTarget) > 0.25f;
        if (moving)
        {
            Vector3 next = Vector3.MoveTowards(cur, petWanderTarget, dt * 0.9f);
            next.y = Ground(next.x, next.z); // stay glued to the actual floor height, not a frozen Y
            // The dog_1/dog_2 source models only ship a single 1-frame "rest pose" take, not an
            // actual walk cycle (verified: both glb's only sub-asset AnimationClip has length=1),
            // so there's no real leg animation to play while moving — without this it just slides
            // across the floor in its standing pose. This fakes a trotting bounce (vertical bob +
            // a small forward/side lean) on the whole model instead, purely procedural, so it
            // visibly looks like it's moving instead of gliding. Swap in a properly-animated pet
            // model later and this stops doing anything (bobAmount naturally goes unused once a
            // real walk clip exists — it's additive on top of the base ground height, harmless).
            petBobPhase += dt * 9f;
            float bob = Mathf.Abs(Mathf.Sin(petBobPhase)) * 0.07f;
            next.y += bob;
            petInstance.transform.position = next;
            Vector3 look = petWanderTarget - cur; look.y = 0;
            if (look.sqrMagnitude > 0.0001f)
                petInstance.transform.rotation = Quaternion.Slerp(petInstance.transform.rotation, Quaternion.LookRotation(look), dt * 5f)
                    * Quaternion.Euler(Mathf.Sin(petBobPhase * 2f) * 4f, 0, 0);
        }
        else
        {
            petBobPhase = 0f;
        }
        if (petAnim != null)
        {
            string target = moving ? (petAnim.walkClip ?? petAnim.idleClip) : petAnim.idleClip;
            if (!string.IsNullOrEmpty(target))
            {
                if (petAnim.anim != null) { if (!petAnim.anim.IsPlaying(target)) petAnim.anim.CrossFade(target, 0.15f); }
                else if (petAnim.animator != null) { var st = petAnim.animator.GetCurrentAnimatorStateInfo(0); if (!st.IsName(target)) petAnim.animator.CrossFade(target, 0.15f); }
            }
        }
    }

    // Waits one frame after Instantiate() before measuring Renderer.bounds — by then Unity
    // has actually run its skinning/bounds update, so this reads the model's TRUE on-screen
    // size instead of a same-frame value that kept coming out wildly wrong (both far too small
    // and, when blindly trusted and corrected for, far too large).
    IEnumerator FitPetModelNextFrame(GameObject instance, float bedTopY, float targetHeight, int slotIndex)
    {
        yield return null;
        if (instance == null) yield break;
        var renderers = instance.GetComponentsInChildren<Renderer>();
        if (renderers.Length == 0) yield break;
        Bounds b = renderers[0].bounds;
        for (int r = 1; r < renderers.Length; r++) b.Encapsulate(renderers[r].bounds);
        if (b.size.y <= 0.0001f)
        {
            Debug.LogWarning("Pet Town 3D pet display " + slotIndex + ": still no usable bounds one frame later (size.y=" + b.size.y + "), leaving at native scale.");
            yield break;
        }
        float feetWorldY = b.min.y;
        float scale = Mathf.Clamp(targetHeight / b.size.y, .001f, 2000f);
        instance.transform.localScale = Vector3.one * scale;
        // Re-measure after scaling — scaling the transform doesn't retroactively change the
        // bounds we already read, so recompute from the renderers again post-scale for an
        // exact fit instead of assuming the pre-scale ratio carries over perfectly.
        renderers = instance.GetComponentsInChildren<Renderer>();
        b = renderers[0].bounds;
        for (int r = 1; r < renderers.Length; r++) b.Encapsulate(renderers[r].bounds);
        instance.transform.position += Vector3.up * (bedTopY - b.min.y);
        Debug.Log("Pet Town 3D pet display " + slotIndex + ": next-frame scale=" + scale + " finalHeight=" + b.size.y + " finalPos=" + instance.transform.position);
    }
    // Generic version of the fitting coroutine above — waits one frame so Renderer.bounds is
    // trustworthy, then uniformly scales to targetHeight and drops the model so its lowest
    // point sits exactly at groundY. Reused for anything instantiated from a prefab at runtime
    // that previously measured bounds on the same frame as Instantiate() (rocks, fences,
    // gates, houses, furniture) — same-frame bounds are the exact bug that made the pet and
    // furniture models randomly come out invisible-tiny or screen-filling-huge.
    IEnumerator FitModelNextFrame(GameObject instance, float groundY, float targetHeight)
    {
        yield return null;
        if (instance == null) yield break;
        var renderers = instance.GetComponentsInChildren<Renderer>();
        if (renderers.Length == 0) yield break;
        Bounds b = renderers[0].bounds;
        for (int r = 1; r < renderers.Length; r++) b.Encapsulate(renderers[r].bounds);
        if (b.size.y <= 0.0001f) yield break;
        float scale = Mathf.Clamp(targetHeight / b.size.y, .001f, 2000f);
        instance.transform.localScale = Vector3.one * scale;
        renderers = instance.GetComponentsInChildren<Renderer>();
        b = renderers[0].bounds;
        for (int r = 1; r < renderers.Length; r++) b.Encapsulate(renderers[r].bounds);
        instance.transform.position += Vector3.up * (groundY - b.min.y);
    }
    [Serializable] class SaveData
    {
        public int coins,population,sold,inventory,hair,face,body,legs,acc,rep,level,day,dogs,cats,bunnies,done,missed;
        public float shopX=999,shopZ;
        public List<int> types=new List<int>();
        public List<float> x=new List<float>(),z=new List<float>();
    }
    void SaveGame()
    {
        SaveData s=new SaveData{coins=money,population=population,sold=sold,inventory=inventory,
            hair=hairStyle,face=faceStyle,body=bodyStyle,legs=legStyle,acc=accessory,
            rep=reputation,level=shopLevel,day=day,dogs=dogStock,cats=catStock,bunnies=rabbitStock,done=completedOrders,missed=missedOrders,
            shopX=shop==null?999:shopPosition.x,shopZ=shopPosition.z};
        foreach(var b in buildings)
        {
            if(b==null||b==shop)continue;
            string n=b.name;for(int i=0;i<types.Length;i++)if(n.StartsWith(types[i].Replace(" ","_")))
            {s.types.Add(i);s.x.Add(b.transform.position.x);s.z.Add(b.transform.position.z);break;}
        }
        PlayerPrefs.SetString("PetTown3D_Save",JsonUtility.ToJson(s));PlayerPrefs.Save();Message("Game saved");
    }
    void LoadGame()
    {
        string json=PlayerPrefs.GetString("PetTown3D_Save","");
        if(string.IsNullOrEmpty(json))return;
        try
        {
            var s=JsonUtility.FromJson<SaveData>(json);
            money=s.coins;population=s.population;sold=s.sold;inventory=s.inventory;
            hairStyle=s.hair;faceStyle=s.face;bodyStyle=s.body;legStyle=s.legs;accessory=s.acc;
            reputation=s.rep;shopLevel=Mathf.Max(1,s.level);day=Mathf.Max(1,s.day);dogStock=s.dogs;catStock=s.cats;rabbitStock=s.bunnies;completedOrders=s.done;missedOrders=s.missed;
            if(s.shopX!=999)
            {
                Vector3 p=new Vector3(s.shopX,Ground(s.shopX,s.shopZ),s.shopZ);
                CreateBuilding(0,p,false);CreateHero(p+new Vector3(8,0,8));CreatePetDisplays();
            }
            var pendingVillagerSpots=new List<Vector3>();
            for(int i=0;i<s.types.Count;i++)
            {
                Vector3 p=new Vector3(s.x[i],Ground(s.x[i],s.z[i]),s.z[i]);
                CreateBuilding(s.types[i],p,false);
                if(s.types[i]!=8) BuildPathTo(shopPosition,p);
                if(s.types[i]==2){pendingVillagerSpots.Add(p+new Vector3(5,0,5));pendingVillagerSpots.Add(p+new Vector3(-5,0,-5));}
            }
            RebakeNavMesh();
            foreach(var spot in pendingVillagerSpots) SpawnVillager(spot);
            Message("Saved town loaded");
        }catch(Exception e){Debug.LogWarning("Save could not be loaded: "+e.Message);}
    }
}
